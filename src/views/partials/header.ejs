<header class="header">

  <a href="/" class="header-titulo">
    <span class="logo-mi">Mi</span>Ecommerce
  </a>

  <!-- buscador -->
  <form action="/search" class="header-buscador" method="GET">
    <input 
        type="text"
        name="query"
        placeholder="Buscar productos..."
        autocomplete="off"    
    >
    <button type="submit">
      <i class="fa-solid fa-magnifying-glass"></i>
    </button>
  </form>

  <!-- navegacion -->
  <nav class="header-acciones">

    <a href="/products" class="header-products">
      Productos
    </a>

    <a href="/cart" class="header-carrito">
      <i class="fa-solid fa-cart-shopping"></i>
      <span class="carrito-count"><%= cartTotal %></span>
    </a>

    <a href="/login" class="header-login">
      Login
    </a>

    <a href="/register" class="header-register">
      Registro
    </a>

  </nav>

</header>