<section class="caja-producto" <%= product.stock === 0 ? 'sin-stock' : '' %>>
  <a href="/products/<%= product.id %>">
    <div class="producto">
      <img 
      src="<%= product.image %>" 
      alt="<%= product.name %>"
      loading="lazy"
      >
      <% if(product.stock === 0) { %>
        <span class="badge-sin-stock">Sin stock</span>
      <% } %>
    </div>

    <div class="descripcion">
      <div class="nombre">
        <h4><%= product.name %></h4>
      </div>

      <div class="puntos-producto">
        <span class="cantidad-puntos"><%= product.points %></span>
        <span class="puntos">PUNTOS</span>
      </div>
    </div>

  </a>
</section>