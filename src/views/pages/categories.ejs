  <main class="categoria-page">

    <h1>
      Categoría:
      <%= category %>
    </h1>

    <% if (filteredProducts.length > 0) { %>

      <section class="productos-grid">

        <% filteredProducts.forEach(product => { %>

          <%- include(
            '../partials/productCard',
            { product }
          ) %>

        <% }) %>

      </section>

    <% } else { %>

      <p>
        No hay productos en esta categoría.
      </p>

    <% } %>

  </main>