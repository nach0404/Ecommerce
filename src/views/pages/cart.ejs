<% style = '<link rel="stylesheet" href="/assets/css/cart.css">' %>

    <main class="carrito-page">

        <a href="/" class="volver"> ↩ Volver </a>

        <h2>Productos en tu Carrito</h2>

        <% if (cartItems.length === 0) { %>

            <!-- CARRITO VACIO -->
             <div class="carrito-vacio">
                <p>El carrito esta vacio😔</p>
                <a href="/" class="btn-volver-inicio"> Ver productos</a>
             </div>

        <% } else { %>

            <!-- LISTA DE PRODUCTOS -->
             <div class="carrito-lista">
                <% cartItems.forEach(item => { %>
                    <div class="carrito-item">
                        <img src="<%= item.image %>" alt="<%= item.name %>">
                        <span class="carrito-nombre"><%= item.name %></span>

                        <!-- BOTON DISMINUIR -->
                         <form action="/cart/decrease/<%= item.id %>" method="POST">
                            <button class="carrito-control-btn">➖</button>
                         </form>

                         <span class="carrito-cantidad"><%= item.quantity %></span>

                         <!-- BOTON AUMENTAR -->
                          <form action="/cart/increase/<%= item.id%>" method="POST">
                            <button class="carrito-control-btn">➕</button>
                          </form>

                          <span class="carrito-puntos">
                            <%= item.subtotal.toLocaleString() %> <small>PUNTOS</small>
                          </span>
                    </div>
                <% }) %>
             </div>

            <!-- TOTAL -->
             <div class="carrito-total">
                <span>Total de puntos</span>
                <strong><%= total.toLocaleString() %></strong>
             </div>

            <!-- ACCIONES -->
             <div class="carrito-acciones">
                  <form action="/cart/clear" method="POST">
                    <button type="submit" class="boton-vaciar">Vaciar carrito</button>
                  </form>
                
                  <a href="/checkout">
                    <button class="boton-pagar">Ir a Pagar</button>
                  </a>
                </div>

        <% } %>

    </main>
