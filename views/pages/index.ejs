<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">

  <meta 
    name="viewport" 
    content="width=device-width, initial-scale=1.0"
  >

  <title>Mi Ecommerce</title>

  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/index.css">
  <link rel="stylesheet" href="/css/productCard.css">

  <link 
    rel="stylesheet" 
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
  >
</head>

<body>

  <%- include('../partials/header') %>


  <main>

    <section class="caja-iconos">

      <% categorias.forEach(cat => { %>

        <div class="item">

          <div class="iconos">
            <i class="fa-solid <%= cat.icon %>"></i>
          </div>

          <h4><%= cat.nombre %></h4>

        </div>

      <% }) %>

      </section>

    <section class="banner">

      <div class="banner-card">

        <img
          src="/imagenes/banner-disney.webp"
          alt="Promo Disney"
        >

        <div class="texto-encima">

          <h3>¡50% OFF!</h3>

          <p>
            Canjeá tus puntos y obtené
            grandes beneficios
          </p>

        </div>

      </div>


      <div class="banner-card">

        <img
          src="/imagenes/banner-hbo.webp"
          alt="Promo HBO Max"
        >

        <div class="texto-encima">

          <h3>¡1 mes GRATIS!</h3>

          <p>
            Canjea desde 30.000 puntos
          </p>

        </div>

      </div>

    </section>

    <% categorias.forEach(cat => { %>

      <section class="categoria-section">

        <!-- TITULO -->
        <div class="categoria-header">

          <h2 class="titulo-productos">
            <%= cat.nombre %>
          </h2>

        </div>

        <section class="productos-grid">

          <% products
            .filter(
              product => product.category === cat.nombre
            )
            .forEach(product => { %>

              <%- include(
                '../partials/productCard',
                { product }
              ) %>

          <% }) %>

        </section>

      </section>

    <% }) %>


  </main>


  <%- include('../partials/footer') %>

</body>
</html>