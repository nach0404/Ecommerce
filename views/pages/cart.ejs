<!DOCTYPE html>
<html lang="es">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Carrito</title>

  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/carrito.css">

</head>

<body>

  <%- include('../partials/header') %>


  <main class="carrito-page">

    <!-- VOLVER -->
    <a href="/" class="volver">
      ← Volver al inicio
    </a>


    <!-- TITULO -->
    <h1>
      Productos de tu carrito
    </h1>


    <!-- PRODUCTOS -->
    <% cart.forEach(product => { %>

      <section class="producto-card">

        <img
          src="<%= product.image %>"
          alt="<%= product.name %>"
        >


        <span class="nombre-producto">
          <%= product.name %>
        </span>


        <!-- CONTROLES -->
        <div class="control">

          <button>-</button>

          <span>1</span>

          <button>+</button>

        </div>


        <!-- PRECIO -->
        <span class="pesos">
          <%= product.points %> PUNTOS
        </span>


        <button class="boton-quitar">
          Quitar
        </button>

      </section>

    <% }) %>



    <!-- TOTAL -->
    <section class="total">

      <h3>Total a pagar</h3>

      <span>

        <%= cart.reduce(
          (total, product) =>
            total + Number(product.points || 0),
          0
        ) %>

        PUNTOS

      </span>

    </section>



    <!-- PAGAR -->
    <div class="pie-carrito">

      <a href="/checkout">

        <button class="boton-pagar">
          Ir a pagar
        </button>

      </a>

    </div>

  </main>


  <%- include('../partials/footer') %>

</body>
</html>