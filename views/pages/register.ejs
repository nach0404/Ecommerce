<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Registro - Mi Ecommerce</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

  <%- include('../partials/header') %>

  <main class="auth-container">

    <h1>Crear cuenta</h1>

    <form action="/register" method="POST" class="auth-form">

      <div class="form-group">
        <label for="name">Nombre</label>
        <input 
          type="text" 
          id="name" 
          name="name" 
          placeholder="Tu nombre"
          required
        >
      </div>

      <div class="form-group">
        <label for="email">Email</label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          placeholder="tu@email.com"
          required
        >
      </div>

      <div class="form-group">
        <label for="password">Contraseña</label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          placeholder="********"
          required
        >
      </div>

      <button type="submit">
        Registrarse
      </button>

    </form>

    <div class="auth-links">
      <p>
        ¿Ya tenés cuenta?
        <a href="/login">Iniciá sesión</a>
      </p>

      <a href="/">Volver al inicio</a>
    </div>

  </main>

  <%- include('../partials/footer') %> <!-- no hay footer todavía -->

</body>
</html>